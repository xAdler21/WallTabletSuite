[Unit]
Description=WallTabletSuite Kiosk (cage + WebKit auf tty1)
After=systemd-user-sessions.service plymouth-quit-wait.service wts-server.service
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=wts-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
# output to the journal, not to tty1 (systemd wipes that on every restart): panel → Logs
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/bin/cage -s -- /opt/walltablet/current/bin/wts-kiosk
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
