[Unit]
Description=WallTabletSuite Server (Web-Panel, API, Kamera, ONVIF)
After=network-online.target
Wants=network-online.target

[Service]
User=kiosk
Environment=WTS_DATA=/var/lib/walltablet
StateDirectory=walltablet
# config.json holds the HA password, ha_tokens.json its tokens
UMask=0077
ExecStart=/opt/walltablet/current/bin/wts-server
# Port 80 for panel and ONVIF without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
