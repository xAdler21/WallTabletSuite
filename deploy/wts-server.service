[Unit]
Description=WallTabletSuite Server (Web-Panel, API, Kamera, ONVIF)
After=network-online.target
Wants=network-online.target

[Service]
User=kiosk
Environment=WTS_DATA=/var/lib/walltablet
StateDirectory=walltablet
ExecStart=/usr/bin/python3 /opt/walltablet/app/server.py
# Port 80 for ONVIF without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
