[Unit]
Description=WallTabletSuite Kiosk (cage + WebKit auf tty1)
After=systemd-user-sessions.service plymouth-quit-wait.service wts-server.service
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=wts-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/usr/bin/cage -s -- /usr/bin/python3 /opt/walltablet/app/kiosk.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
